function sendResult(p){
  lastPayload=3Dp;
  if(!SHEET_URL||!window.fetch){ sendState=3DSHEET_URL?"failed":"off"; setS=
endStatus(); return; }
  sendState=3D"sending"; setSendStatus();
  var timer=3DsetTimeout(function(){ if(sendState=3D=3D=3D"sending"){ sendS=
tate=3D"failed"; setSendStatus(); } },20000);
  fetch(SHEET_URL,{method:"POST",mode:"no-cors",headers:{"Content-Type":"te=
xt/plain;charset=3Dutf-8"},body:buildBody(p)})
    .then(function(){
      clearTimeout(timer); sendState=3D"sent"; p.sent=3Dtrue;
      try{ localStorage.setItem(STORE_KEY,JSON.stringify(p)); }catch(e){}
      setSendStatus();
