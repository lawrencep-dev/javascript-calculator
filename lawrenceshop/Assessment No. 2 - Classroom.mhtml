function buildBody(p){
  var parts=3D[];
  for(var i=3D0;i&lt;Q.length;i++){ var v=3Dp.answers&amp;&amp;p.answers[Q[=
i].n]; parts.push(Q[i].n+":"+(v=3D=3Dnull?"":v)); }
  return JSON.stringify({name:p.name,section:p.section,score:p.score,total:=
Q.length,
    percent:Math.round(p.score/Q.length*100),violations:p.violations,reason=
:p.reason,
    submittedAt:p.date,deviceId:p.deviceId||getDeviceId(),answers:parts.joi=
n(" | ")});
}
