function norm(x){
  return String(x=3D=3Dnull?"":x).toLowerCase().trim()
    .replace(/\s+/g,"").replace(/,/g,"")
    .replace(/php|=E2=82=B1/g,"").replace(/pesos?/g,"")
    .replace(/[()]/g,"").replace(/["'`]/g,"")
    .replace(/\.00$|\.0$/,"");
}
function isCorrect(q,val){
  if(val=3D=3Dnull||val=3D=3D=3D"") return false;
  if(q.t=3D=3D=3D"mc") return String(val).toUpperCase()=3D=3D=3Dq.a;
  var set=3D(q.ac||[]).slice(); set.push(q.a);
  var nv=3Dnorm(val);
  for(var i=3D0;i&lt;set.length;i++){ if(norm(set[i])=3D=3D=3Dnv) return tr=
ue; }
  return false;
}

